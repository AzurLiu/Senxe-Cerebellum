      "protocol_id": "senxe_contact_skill_v2",
      "evidence_level": "project_design",
      "source_url": null,
      "claim_boundary": "A proposed CL1-ready multi-axis contact-skill protocol. Simulator results do not establish biological learning.",
      "artifact_wait_ms": 50.0,
      "collect_window_ms": 50.0,
      "encoder_policy": "Fixed 18-channel compact alignment, force, three-bit external-phase and contact encoder throughout comparison phases. Magnitude uses bounded amplitude rather than extra electrodes.",
      "decoder_policy": "Fixed zero-bias five-output count decoder reading only 20 disjoint motor electrodes, with two positive and two negative electrodes per output.",
      "feedback_policy": "Six disjoint channels deliver cooldown-limited contact-progress, collision and success stimulation only during feedback_training. The remaining 15 stimulatable channels are reserved. The laboratory-approved amplitude, phase width, frequency, burst count, pulse count and absolute-charge envelope is enforced before every SDK call.",
